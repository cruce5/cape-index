{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "cape-index",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // capeindex.com + www serve the site directly. thecapeindex.com (and its www)
  // 301 to capeindex.com via a Cloudflare Redirect Rule on that zone, not here.
  "routes": [
    { "pattern": "capeindex.com", "custom_domain": true },
    { "pattern": "www.capeindex.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
